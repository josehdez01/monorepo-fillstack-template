{
    "name": "@template/monorepo",
    "version": "0.0.0",
    "description": "An opinionated TypeScript fullstack template with oRPC contracts, MikroORM, typed Torero jobs, and React.",
    "scripts": {
        "test": "pnpm test:tooling && turbo run test --filter=!@template/e2e",
        "dev": "pnpm env:setup && turbo run dev --filter=@template/backend --filter=frontend/user_app",
        "dev:all": "pnpm env:setup && turbo run dev",
        "build": "turbo run build",
        "lint": "oxlint --fix . && pnpm format",
        "lint:check": "oxlint . && pnpm format:check",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit -p tsconfig.tooling.json && turbo run typecheck",
        "postinstall": "simple-git-hooks",
        "gen": "turbo gen",
        "env:setup": "node --import tsx scripts/env/materialize.ts",
        "env:doctor": "node --conditions=development --import tsx scripts/env/doctor.ts",
        "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
        "infra:down": "docker compose -f infra/docker-compose.yml stop",
        "mint": "tsx scripts/mint.ts",
        "test:watch": "vitest",
        "test:tooling": "vitest run --config vitest.config.ts",
        "test:integration": "node scripts/test-services.mjs integration",
        "test:e2e": "node scripts/test-services.mjs e2e",
        "check": "pnpm lint:check && pnpm typecheck && pnpm test && pnpm build",
        "setup": "pnpm env:setup && pnpm infra:up && pnpm --filter @template/backend db:migrate:up",
        "test:coverage": "pnpm exec vitest run --coverage && turbo run test --filter=!@template/e2e -- --coverage",
        "test:generators": "node scripts/test-generators.mjs"
    },
    "keywords": [
        "monorepo",
        "template",
        "typescript",
        "turbo",
        "hono",
        "react"
    ],
    "author": "",
    "license": "MIT",
    "type": "module",
    "private": true,
    "packageManager": "pnpm@12.14.0",
    "engines": {
        "node": ">=26.12.0 <27",
        "pnpm": ">=12.14.0 <13"
    },
    "devDependencies": {
        "@template/env": "workspace:*",
        "@turbo/gen": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "lint-staged": "catalog:",
        "oxlint": "catalog:",
        "prettier": "catalog:",
        "simple-git-hooks": "catalog:",
        "tsdown": "catalog:",
        "tsx": "catalog:",
        "turbo": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "zod": "catalog:",
        "@types/node": "catalog:"
    },
    "simple-git-hooks": {
        "pre-commit": "pnpm lint-staged"
    },
    "lint-staged": {
        "**/*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
            "prettier --write"
        ],
        "**/*.{ts,tsx}": [
            "oxlint --fix"
        ]
    }
}
