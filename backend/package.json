{
    "name": "@template/backend",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "vitest run",
        "db:entities:gen": "node --import tsx ../scripts/gen-entities-registry.ts",
        "dev": "pnpm db:entities:gen && pnpm db:migrations:gen && node --conditions=development --import tsx --watch src/index.ts",
        "build": "pnpm db:entities:gen && pnpm db:migrations:gen && tsdown",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "env:setup": "node --conditions=development --import tsx src/scripts/env-materialize.ts",
        "db:migrate:create": "node --conditions=development --import tsx src/scripts/migrations-create.ts",
        "db:migrate:up": "node --conditions=development --import tsx src/scripts/migrations-up.ts",
        "db:migrate:down": "node --conditions=development --import tsx src/scripts/migrations-down.ts",
        "lint": "oxlint --fix .",
        "lint:check": "oxlint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "start:worker": "ROLE=worker pnpm start",
        "test:watch": "vitest",
        "test:integration": "vitest run src/test/integration.test.ts",
        "db:migrations:gen": "node --conditions=development --import tsx src/scripts/migrations-registry.ts",
        "jobs:demo": "node --conditions=development --import tsx src/scripts/queue-demo.ts"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "type": "module",
    "dependencies": {
        "@hono/node-server": "catalog:",
        "@mikro-orm/core": "catalog:",
        "@mikro-orm/postgresql": "catalog:",
        "@orpc/server": "catalog:",
        "@template/contracts": "workspace:*",
        "@template/env": "workspace:*",
        "@template/logger": "workspace:*",
        "bullmq": "catalog:",
        "hono": "catalog:",
        "ioredis": "catalog:",
        "pg": "catalog:",
        "pino": "catalog:",
        "torero-mq": "catalog:",
        "zod": "catalog:",
        "@mikro-orm/migrations": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "tsdown": "catalog:",
        "tsx": "catalog:",
        "vitest": "catalog:",
        "@types/pg": "catalog:"
    },
    "private": true
}
