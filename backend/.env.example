NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=template-queues
ROLE=all
# Explicit local frontend origins. Production defaults to same-origin only.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Enable only behind a reverse proxy that replaces untrusted forwarded headers.
TRUST_PROXY=false
