{
    "name": "@template/contracts",
    "version": "1.0.0",
    "description": "",
    "main": "dist/orpc/contract.js",
    "scripts": {
        "test": "vitest run",
        "build": "tsdown",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "oxlint --fix .",
        "lint:check": "oxlint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:watch": "vitest"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "type": "module",
    "exports": {
        "./orpc/*": {
            "development": "./src/orpc/*.ts",
            "types": "./dist/orpc/*.d.ts",
            "import": "./dist/orpc/*.js",
            "default": "./dist/orpc/*.js"
        },
        "./types/*": {
            "development": "./src/types/*.ts",
            "types": "./dist/types/*.d.ts",
            "import": "./dist/types/*.js",
            "default": "./dist/types/*.js"
        },
        "./utils/*": {
            "development": "./src/utils/*.ts",
            "types": "./dist/utils/*.d.ts",
            "import": "./dist/utils/*.js",
            "default": "./dist/utils/*.js"
        },
        "./queues/*": {
            "development": "./src/queues/*.ts",
            "types": "./dist/queues/*.d.ts",
            "import": "./dist/queues/*.js",
            "default": "./dist/queues/*.js"
        }
    },
    "dependencies": {
        "@orpc/contract": "catalog:",
        "zod": "catalog:",
        "torero-mq": "catalog:"
    },
    "devDependencies": {
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
