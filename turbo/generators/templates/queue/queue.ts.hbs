import { job, implement } from 'torero-mq';
import { z } from 'zod';

// Move the contract to contracts/src/queues when another package needs to publish it.
export const {{camelCase name}}Job = job('{{kebabCase name}}', { version: 1 })
    .input(z.object({ example: z.string().min(1) }))
    .output(z.object({ ok: z.boolean() }))
    .options({ attempts: 3, backoff: { type: 'exponential', delay: 1000 } });

export const {{camelCase name}}Queue = implement({{camelCase name}}Job)
    .worker({ concurrency: 5, timeoutMs: 15_000 })
    .handler(({ input, signal }) => {
        signal.throwIfAborted();
        return { ok: input.example.length > 0 };
    });

