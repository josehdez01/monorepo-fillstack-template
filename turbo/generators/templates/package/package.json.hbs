{
    "name": "@template/{{name}}",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint --fix 'src/**/*.{ts,tsx}'",
        "lint:check": "oxlint 'src/**/*.{ts,tsx}'",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "tsdown": "catalog:",
        "typescript": "catalog:"
    },
    "exports": {
        ".": {
            "development": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    }
}
