{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "dist",
        "jsx": "react-jsx",
        "types": [
            "vite/client"
        ],
        "noEmit": true,
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "module": "ESNext",
        "moduleResolution": "Bundler"
    },
    "include": [
        "src",
        "vite.config.ts",
        "env.d.ts"
    ],
    "exclude": [
        "src/**/*.test.ts",
        "src/**/*.test.tsx"
    ]
}
