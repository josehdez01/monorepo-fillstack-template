{
    "name": "@template/ui",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "exports": {
        "./shadcn": {
            "development": "./src/shadcn/index.ts",
            "types": "./dist/shadcn/index.d.ts",
            "import": "./dist/shadcn/index.js",
            "default": "./dist/shadcn/index.js"
        },
        "./shadcn/*": {
            "development": "./src/shadcn/ui/*.tsx",
            "types": "./dist/shadcn/ui/*.d.ts",
            "import": "./dist/shadcn/ui/*.js",
            "default": "./dist/shadcn/ui/*.js"
        },
        "./retroui": {
            "development": "./src/retroui/index.ts",
            "types": "./dist/retroui/index.d.ts",
            "import": "./dist/retroui/index.js",
            "default": "./dist/retroui/index.js"
        },
        "./lib/*": {
            "development": "./src/lib/*.ts",
            "types": "./dist/lib/*.d.ts",
            "import": "./dist/lib/*.js",
            "default": "./dist/lib/*.js"
        },
        "./retroui/*": {
            "development": "./src/components/retroui/*.tsx",
            "types": "./dist/components/retroui/*.d.ts",
            "import": "./dist/components/retroui/*.js",
            "default": "./dist/components/retroui/*.js"
        },
        "./starter-shell": {
            "development": "./src/components/starter-shell.tsx",
            "types": "./dist/components/starter-shell.d.ts",
            "import": "./dist/components/starter-shell.js",
            "default": "./dist/components/starter-shell.js"
        },
        "./starter.css": {
            "development": "./src/starter.css",
            "default": "./src/starter.css"
        },
        "./theme.css": "./src/theme.css",
        "./hooks/*": {
            "development": "./src/hooks/*.tsx",
            "types": "./dist/hooks/*.d.ts",
            "default": "./dist/hooks/*.js"
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc -p tsconfig.typecheck.json",
        "lint": "oxlint --fix .",
        "lint:check": "oxlint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "dependencies": {
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@headlessui/react": "catalog:",
        "@hookform/resolvers": "catalog:",
        "@radix-ui/react-accordion": "catalog:",
        "@radix-ui/react-alert-dialog": "catalog:",
        "@radix-ui/react-aspect-ratio": "catalog:",
        "@radix-ui/react-avatar": "catalog:",
        "@radix-ui/react-checkbox": "catalog:",
        "@radix-ui/react-collapsible": "catalog:",
        "@radix-ui/react-context-menu": "catalog:",
        "@radix-ui/react-dialog": "catalog:",
        "@radix-ui/react-dropdown-menu": "catalog:",
        "@radix-ui/react-hover-card": "catalog:",
        "@radix-ui/react-label": "catalog:",
        "@radix-ui/react-menubar": "catalog:",
        "@radix-ui/react-navigation-menu": "catalog:",
        "@radix-ui/react-popover": "catalog:",
        "@radix-ui/react-progress": "catalog:",
        "@radix-ui/react-radio-group": "catalog:",
        "@radix-ui/react-scroll-area": "catalog:",
        "@radix-ui/react-select": "catalog:",
        "@radix-ui/react-separator": "catalog:",
        "@radix-ui/react-slider": "catalog:",
        "@radix-ui/react-slot": "catalog:",
        "@radix-ui/react-switch": "catalog:",
        "@radix-ui/react-tabs": "catalog:",
        "@radix-ui/react-toggle": "catalog:",
        "@radix-ui/react-toggle-group": "catalog:",
        "@radix-ui/react-tooltip": "catalog:",
        "@radix-ui/react-visually-hidden": "catalog:",
        "class-variance-authority": "catalog:",
        "clsx": "catalog:",
        "cmdk": "catalog:",
        "date-fns": "catalog:",
        "embla-carousel-react": "catalog:",
        "input-otp": "catalog:",
        "lucide-react": "catalog:",
        "next-themes": "catalog:",
        "react-day-picker": "catalog:",
        "react-hook-form": "catalog:",
        "react-resizable-panels": "catalog:",
        "recharts": "catalog:",
        "sonner": "catalog:",
        "tailwind-merge": "catalog:",
        "vaul": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "react": "catalog:",
        "react-dom": "catalog:"
    }
}
